{
  "info": {
    "name": "Di Động Việt - Voucher API Tests",
    "description": "Postman collection riêng cho các test voucher của API Di Động Việt",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Voucher (Admin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"TEST_PROMO10\",\n  \"description\": \"Voucher test giảm 10%\",\n  \"discountType\": \"percentage\",\n  \"discountValue\": 10,\n  \"maxDiscount\": 500000,\n  \"minOrderAmount\": 1000000,\n  \"startDate\": \"2026-05-01T00:00:00.000Z\",\n  \"expiryDate\": \"2026-12-31T23:59:59.999Z\",\n  \"usageLimit\": 100,\n  \"isActive\": true\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/vouchers",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "vouchers"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Response has success true\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "});",
              "pm.test(\"Response includes voucher id\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data).to.have.property('_id');",
              "    pm.expect(jsonData.data.code).to.eql('TEST_PROMO10');",
              "});",
              "if (pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    pm.collectionVariables.set('voucher_id', jsonData.data._id);",
              "    pm.collectionVariables.set('voucher_code', jsonData.data.code);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get All Vouchers",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/vouchers",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "vouchers"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response has success true\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "});",
              "pm.test(\"Response has voucher array\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get Voucher by Code",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/vouchers/{{voucher_code}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "vouchers", "{{voucher_code}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response has success true\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "});",
              "pm.test(\"Voucher code matches\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.code).to.eql(pm.collectionVariables.get('voucher_code'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get All Vouchers Admin",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/vouchers/admin",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "vouchers", "admin"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response has success true\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "});",
              "pm.test(\"Response has voucher list\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Update Voucher (Admin)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Voucher test cập nhật\",\n  \"discountValue\": 15\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/vouchers/{{voucher_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "vouchers", "{{voucher_id}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response has success true\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "});",
              "pm.test(\"Voucher updated fields match\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.description).to.eql('Voucher test cập nhật');",
              "    pm.expect(jsonData.data.discountValue).to.eql(15);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Delete Voucher (Admin)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/vouchers/{{voucher_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "vouchers", "{{voucher_id}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response has success true\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "});",
              "pm.test(\"Response contains delete message\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.message).to.include('xóa');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "your_admin_jwt_token_here",
      "type": "string"
    },
    {
      "key": "voucher_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "voucher_code",
      "value": "TEST_PROMO10",
      "type": "string"
    }
  ]
}

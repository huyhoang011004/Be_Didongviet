          "mode": "raw",
          "raw": "{\n  \"name\": \"iPhone 16 Pro Max Test\",\n  \"category\": \"{{category_id}}\",\n  \"brand\": \"Apple\",\n  \"description\": \"Điện thoại cao cấp cho test\",\n  \"variants\": [\n    {\n      \"color\": \"Titan Sa Mạc\",\n      \"ram\": \"8GB\",\n      \"rom\": \"256GB\",\n      \"price\": 35000000,\n      \"salePrice\": 32000000,\n      \"stock\": 10,\n      \"sku\": \"IP16PM-256-TITAN-TEST\"\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/products",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "products"]
        },
        "description": "Tạo sản phẩm mới (yêu cầu quyền Admin)"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response has success true\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "});",
              "",
              "pm.test(\"Product has required fields\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data).to.have.property('name');",
              "    pm.expect(jsonData.data).to.have.property('_id');",
              "    pm.expect(jsonData.data).to.have.property('variants');",
              "});",
              "",
              "// Lưu product_id cho các test sau",
              "if (pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    pm.collectionVariables.set('product_id', jsonData.data._id);",
              "    pm.collectionVariables.set('product_slug', jsonData.data.slug);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },

{
  "name": "be_didongviet",
  "version": "1.0.0",
  "description": "Backend API cho website Di Động Việt, cung cấp các chức năng quản lý sản phẩm, người dùng, đơn hàng, và các tính năng liên quan đến thương mại điện tử.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "test": "echo \"Error: no test specified\" && exit 0"
  },
  "keywords": [
    "Node.js",
    "Express",
    "MongoDB",
    "API",
    "E-commerce",
    "Di Động Việt"
  ],
  "author": "Nguyễn Văn Huy Hoàng",
  "license": "ISC",
  "type": "module",
  "imports": {
    "#utils/*.js": "./src/utils/*.js",
    "#middlewares/*.js": "./src/middlewares/*.js",
    "#config/*.js": "./src/config/*.js",
    "#auth/*.js": "./src/modules/auth-user/Auth/*.js",
    "#account/*.js": "./src/modules/auth-user/Account/*.js",
    "#category/*.js": "./src/modules/catalog/Category/*.js",
    "#product/*.js": "./src/modules/catalog/Product/*.js",
    "#cart/*.js": "./src/modules/sales/Cart/*.js",
    "#order/*.js": "./src/modules/sales/Order/*.js",
    "#voucher/*.js": "./src/modules/sales/Voucher/*.js",
    "#blog/*.js": "./src/modules/cms/Blog/*.js",
    "#studentProfile/*.js": "./src/modules/auth-user/StudentProfile/*.js",
    "#branch/*.js": "./src/modules/fulfillment/Branch/*.js",
    "#contact/*.js": "./src/modules/cms/Contact/*.js",
    "#review/*.js": "./src/modules/cms/Review/*.js",
    "#routes/*.js": "./src/routes/*.js",
    "#inventory/*.js": "./src/modules/fulfillment/Inventory/*.js",
    "#flashSale/*.js": "./src/modules/catalog/FlashSale/*.js",
    "#analytics/*.js": "./src/modules/analytics/Analytics/*.js",
    "#payment/*.js": "./src/modules/sales/Payment/*.js",
    "#ghn/*.js": "./src/modules/fulfillment/GHN/*.js",
    "#banner/*.js": "./src/modules/cms/Banner/*.js"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "fluent-ffmpeg": "2.1.3",
    "helmet": "8.1.0",
    "joi": "18.2.3",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.6.1",
    "morgan": "1.10.1",
    "multer": "2.1.1",
    "nodemailer": "8.0.7",
    "sharp": "0.34.5",
    "slugify": "1.6.9"
  },
  "devDependencies": {
    "eslint": "10.3.0",
    "nodemon": "3.1.14"
  }
}
# ============================================================
# CẤU HÌNH MÔI TRƯỜNG - BACKEND DI ĐỘNG VIỆT
# ============================================================
# Sao chép file này thành .env và điền giá trị thực tế
# cp .env.example .env

# ---- MÔI TRƯỜNG CHẠY ----
NODE_ENV=development

# ---- CỔNG SERVER ----
PORT=5000

# ---- KẾT NỐI MONGODB ----
# Đối với MongoDB local: mongodb://localhost:27017/didongviet
# Đối với MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.xxxxx.mongodb.net/didongviet
MONGODB_CONNECTION_STRING=

# ---- BASE URL ----
# Dùng để tạo đường dẫn ảnh đầy đủ
BASE_URL=http://localhost:5000

# ---- JWT AUTHENTICATION ----
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_TTL=7d
REFRESH_TOKEN_TTL=30d

# ---- GMAIL (GỬI EMAIL OTP) ----
# Cần tạo "Mật khẩu ứng dụng" trong tài khoản Gmail (16 ký tự)
# Vào: https://myaccount.google.com/apppasswords
GMAIL_ADMIN=
GMAIL_APP_PASSWORD=


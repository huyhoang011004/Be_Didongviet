# ============================================================
# CẤU HÌNH MÔI TRƯỜNG - BACKEND DI ĐỘNG VIỆT
# ============================================================
# Sao chép file này thành .env rồi điền giá trị thực tế
# cp .env.example .env

PORT=5000
NODE_ENV=development

# URL backend (khi deploy Render: https://your-app.onrender.com)
BASE_URL=http://localhost:5000

# URL frontend (khi deploy Vercel: https://your-app.vercel.app)
CLIENT_URL=http://localhost:3000

# ---- KẾT NỐI MONGODB ----
# MongoDB local:  mongodb://localhost:27017/didongviet
# MongoDB Atlas:  mongodb+srv://<user>:<password>@cluster.xxxxx.mongodb.net/didongviet
MONGODB_CONNECTION_STRING=

# ---- JWT AUTHENTICATION ----
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=14d

# ---- GMAIL (GỬI EMAIL OTP) ----
# Tạo "Mật khẩu ứng dụng" tại: https://myaccount.google.com/apppasswords
GMAIL_ADMIN=
GMAIL_APP_PASSWORD=

# ---- GHN (GIAO HÀNG NHANH) ----
# Đăng ký tại: https://ghn.vn
GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_TOKEN=
GHN_SHOP_ID=

# ---- MOMO PAYMENT ----
# Đăng ký tại: https://developers.momo.vn
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=F8BBA842ECF85
MOMO_SECRET_KEY=K951B6PE1waDMi640xX08PD3vg6EkVlz
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
# Redirect & IPN URL được tự động ghép từ CLIENT_URL và BASE_URL

# ---- VNPAY PAYMENT ----
# Đăng ký tại: https://sandbox.vnpayment.vn
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Return & IPN URL được tự động ghép từ CLIENT_URL và BASE_URL